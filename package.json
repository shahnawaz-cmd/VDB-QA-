{
  "name": "vdb-playwright-e2e",
  "version": "1.0.0",
  "description": "Enterprise Playwright E2E automation framework for dev.vehicledatabases.com",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:bvt": "playwright test --grep \"@bvt\"",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:forms": "playwright test --grep \"@forms\"",
    "test:e2e": "playwright test --grep \"@e2e\"",
    "test:faq": "playwright test --grep \"@faq\"",
    "test:interactive": "playwright test --grep \"@interactive\"",
    "test:coverage": "playwright test --grep \"@coverage\"",
    "test:downloads": "playwright test --grep \"@downloads\"",
    "test:sitemap": "playwright test --grep \"@sitemap\"",
    "test:dark": "playwright test --grep \"@dark\"",
    "test:translation": "playwright test --grep \"@translation\"",
    "test:mobile-overflow": "playwright test --grep \"@overflow\"",
    "test:mobile": "playwright test --grep \"@mobile\"",
    "test:all:dark": "playwright test --project=desktop-dark",
    "test:nonfunctional": "playwright test --grep \"@nonfunctional\"",
    "test:regression": "playwright test --grep \"@regression\"",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "vehicledatabases"
  ],
  "author": "Antigravity QA",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
